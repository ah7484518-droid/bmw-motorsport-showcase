function drawLogoText() {
  const ctx = logoCanvas.getContext("2d");
  const width = logoCanvas.width;
  const height = logoCanvas.height;

  ctx.clearRect(0, 0, width, height);
  ctx.fillStyle = "#000000";
  ctx.fillRect(0, 0, width, height);

  ctx.textAlign = "center";
  ctx.textBaseline = "middle";

  if ("letterSpacing" in ctx) {
    ctx.letterSpacing = "44px";
  }

  // نصغّر الخط لو الاسم أعرض من الصورة.
  let fontSize = 300;
  const fontStack = LOGO_FONT + ', "Arial Black", Arial, sans-serif';

  ctx.font = fontSize + "px " + fontStack;

  while (ctx.measureText(LOGO_TEXT).width > 1760 && fontSize > 100) {
    fontSize -= 10;
    ctx.font = fontSize + "px " + fontStack;
  }

  // ألوان هوية ORVEX: سماوي فاتح لأزرق ملكي.
  const gradient = ctx.createLinearGradient(190, 0, 1858, 0);
  gradient.addColorStop(0, "#5cf0ff");
  gradient.addColorStop(0.5, "#2f8bff");
  gradient.addColorStop(1, "#2a45ff");

  ctx.fillStyle = gradient;

  // وهج ناعم + تعبئة حادة + حد رفيع فاتح للمسة راقية.
  ctx.shadowColor = "rgba(60, 150, 255, 0.55)";
  ctx.shadowBlur = 45;
  ctx.fillText(LOGO_TEXT, width / 2, height / 2);

  ctx.shadowBlur = 0;
  ctx.fillText(LOGO_TEXT, width / 2, height / 2);

  ctx.lineWidth = 2.5;
  ctx.strokeStyle = "rgba(190, 240, 255, 0.4)";
  ctx.strokeText(LOGO_TEXT, width / 2, height / 2);

  logoTexture.needsUpdate = true;
}

