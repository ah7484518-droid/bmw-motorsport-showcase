const LOGO_SCALE = 0.92;
const LOGO_OPACITY = 0.6;

// بدل صورة اللوجو، بنرسم اسم الشركة كنص بألوان الهوية (سماوي → أزرق).
const LOGO_TEXT = "ORVEX";
