    const name = (object.name || "").toLowerCase();

    const isTire =
      (name.includes("wheel") || name.includes("tirebmw")) &&
      !name.includes("brake") &&
      !name.includes("hub") &&
      !name.includes("disk") &&
      !name.includes("disc");

    if (isTire) {
      result.push(object);
    }
  });

  return result;
}


// ======================================================
// 21. تجهيز الموديل
// ======================================================

function prepareModel(model) {
  model.traverse((object) => {
    if (!object.isMesh) {
      return;
    }

    object.castShadow = true;
    object.receiveShadow = true;

    if (object.material) {
      const materials = Array.isArray(object.material)
        ? object.material
        : [object.material];

      materials.forEach((material) => {
        material.envMapIntensity = 1.4;
      });
    }
  });

  const originalBox = new THREE.Box3().setFromObject(model);
  const originalSize = originalBox.getSize(new THREE.Vector3());
  const originalWidth = Math.max(originalSize.x, originalSize.z);

  if (!originalWidth || originalWidth <= 0) {
    throw new Error("تعذر حساب حجم موديل BMW");
  }

  const targetWidth = 7.2;
  model.scale.setScalar(targetWidth / originalWidth);

  const scaledBox = new THREE.Box3().setFromObject(model);
  const center = scaledBox.getCenter(new THREE.Vector3());

  model.position.x -= center.x;
  model.position.z -= center.z;

  const finalBox = new THREE.Box3().setFromObject(model);

  model.position.y -= finalBox.min.y;
  model.position.y += CAR_LIFT;

  return model;
}


