function layoutLogo() {
  const visibleHeight =
    2 *
    LOGO_DISTANCE *
    Math.tan(THREE.MathUtils.degToRad(camera.fov / 2));

  const visibleWidth = visibleHeight * camera.aspect;

  // الاسم كبير: بياخد تقريبًا عرض الشاشة كله (وبحد أقصى حسب الارتفاع).
  const logoWidth = Math.min(visibleWidth * LOGO_SCALE, visibleHeight * 2.1);

  logoMesh.scale.set(logoWidth, logoWidth / 2, 1);

  // متنصف أفقيًا وفي الجزء العلوي من الشاشة، فيبان فوق العربية.
  logoMesh.position.set(0, visibleHeight * 0.27, -LOGO_DISTANCE);
}

