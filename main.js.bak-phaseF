// ======================================================
// BMW M4 GT3 EVO 2025
// Cinematic Interactive Experience + Engine Audio
// ======================================================

import * as THREE from "three";
import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";
import { OrbitControls } from "three/addons/controls/OrbitControls.js";
import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

// ======================================================
// 1. عناصر الصفحة
// ======================================================

const container = document.querySelector("#scene-container");
const loadingMessage = document.querySelector(".loading");

if (!container) {
  throw new Error("العنصر #scene-container غير موجود داخل index.html");
}

const reduceMotion = window.matchMedia(
  "(prefers-reduced-motion: reduce)"
).matches;

const isMobile = window.matchMedia(
  "(max-width: 768px)"
).matches;

const maxPixelRatio = isMobile ? 1.2 : 1.5;

// ======================================================
// 2. المشهد والكاميرا
// ======================================================

const scene = new THREE.Scene();
scene.background = new THREE.Color("#010204");
scene.fog = new THREE.Fog("#010204", 22, 60);

const camera = new THREE.PerspectiveCamera(
  38,
  window.innerWidth / window.innerHeight,
  0.1,
  200
);

const cameraStart = new THREE.Vector3(-11, 3, -0.55);
const cameraEnd = new THREE.Vector3(-8, 2.2, -5.5);
const lookTarget = new THREE.Vector3(0, 0.75, -1.4);

camera.position.copy(cameraStart);
camera.lookAt(lookTarget);

// ======================================================
// 3. Renderer
// ======================================================

const renderer = new THREE.WebGLRenderer({
  antialias: true,
  alpha: false,
  powerPreference: "high-performance"
});

renderer.setPixelRatio(Math.min(window.devicePixelRatio, maxPixelRatio));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.18;

container.appendChild(renderer.domElement);

// ======================================================
// 4. رسالة التحميل
// ======================================================

if (loadingMessage) {
  loadingMessage.textContent = "Loading BMW M4 GT3 EVO...";
}

// ======================================================
// 5. Environment Map
// ======================================================

const pmremGenerator = new THREE.PMREMGenerator(renderer);
const roomEnvironment = new RoomEnvironment(renderer);

scene.environment = pmremGenerator.fromScene(roomEnvironment, 0.04).texture;

roomEnvironment.dispose();
pmremGenerator.dispose();

// ======================================================
// 6. OrbitControls
// ======================================================

const controls = new OrbitControls(camera, renderer.domElement);

controls.enabled = false;
controls.enableDamping = true;
controls.dampingFactor = 0.055;
controls.target.copy(lookTarget);
controls.minDistance = 4;
controls.maxDistance = 13;
controls.maxPolarAngle = Math.PI * 0.48;
controls.autoRotate = false;
controls.autoRotateSpeed = 0.8;

let autoRotateTimer = null;
let entranceFinished = false;

function scheduleAutoRotate(delay) {
  clearTimeout(autoRotateTimer);

  if (reduceMotion) {
    return;
  }

  autoRotateTimer = setTimeout(() => {
    controls.autoRotate = entranceFinished;
  }, delay);
}

controls.addEventListener("start", () => {
  controls.autoRotate = false;
  clearTimeout(autoRotateTimer);
});

controls.addEventListener("end", () => {
  scheduleAutoRotate(4000);
});

