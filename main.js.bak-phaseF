function createExhaustFlame(x, y, z) {
  const flame = new THREE.Mesh(
    new THREE.ConeGeometry(0.12, 0.55, 12),
    new THREE.MeshBasicMaterial({
      color: 0xff6a00,
      transparent: true,
      opacity: 0.9,
      blending: THREE.AdditiveBlending
    })
  );

  flame.rotation.z = -Math.PI / 2;
  flame.position.set(x + 0.275, y, z);
  exhaustFireGroup.add(flame);

  return flame;
}

const flameLeft = createExhaustFlame(3.35, 0.18, -0.42);
const flameRight = createExhaustFlame(3.35, 0.18, 0.42);

// ======================================================
// 14.1 جزيئات نار الشكمان
// ======================================================

const exhaustParticles = new THREE.Group();
exhaustParticles.visible = false;
carGroup.add(exhaustParticles);

const exhaustParticleGeometry = new THREE.SphereGeometry(0.045, 6, 6);
const exhaustParticleData = [];

for (let index = 0; index < 18; index += 1) {
  const particle = new THREE.Mesh(
    exhaustParticleGeometry,
    new THREE.MeshBasicMaterial({
      color: 0xff8a00,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    })
  );

  const baseZ = index % 2 === 0 ? -0.42 : 0.42;
  const baseScale = 0.5 + Math.random() * 0.8;

  particle.position.set(3.35, 0.18, baseZ);
  particle.scale.setScalar(baseScale);
  exhaustParticles.add(particle);

  exhaustParticleData.push({
    particle,
    baseZ,
    baseScale,
    speed: 0.003 + Math.random() * 0.006,
    offset: Math.random() * Math.PI * 2,
    life: Math.random()
  });
}

