// ======================================================
// 15. مسار دخول السيارة
// ======================================================

const startPosition = new THREE.Vector3(18, 0, -1.4);
const endPosition = new THREE.Vector3(0, 0, -1.4);

const startScale = 0.08;
const endScale = 0.92;
const entranceDuration = reduceMotion ? 3000 : 9000;

// ======================================================
// 16. حالات المشهد
// ======================================================

let modelReady = false;
let animationStartTime = 0;
let lastTime = performance.now();
let stopTime = 0;
let doorsStarted = false;
let doorsFinished = false;
let revBoost = 0;
let settleTime = 0;
let suspensionRoll = 0;
let lastAzimuth = 0;

// ======================================================
// 16.1 حركة السيارة مع تمرير الصفحة
// ======================================================

let pageScrollProgress = 0;
let scrollCarTilt = 0;

window.addEventListener(
  "scroll",
  () => {
    const pageHeight =
      document.documentElement.scrollHeight - window.innerHeight;

    if (pageHeight <= 0) {
      pageScrollProgress = 0;
      return;
    }

    pageScrollProgress = THREE.MathUtils.clamp(
      window.scrollY / pageHeight,
      0,
      1
    );
  },
  { passive: true }
);

// ======================================================
// 17. مجموعات الأبواب والعجلات
// ======================================================

const leftDoorPivot = new THREE.Group();
const rightDoorPivot = new THREE.Group();

leftDoorPivot.visible = false;
rightDoorPivot.visible = false;

realCarGroup.add(leftDoorPivot, rightDoorPivot);

const wheelParts = [];

// ======================================================
// 18. التعرف على الأبواب
// ======================================================

function isLeftDoorName(name) {
  return /^BMWANC_Door_L_/i.test(name);
}

function isRightDoorName(name) {
  return /^BMWANC_Door_R_/i.test(name);
}

// ======================================================
// 19. تجميع قطع الأبواب
// ======================================================

function getDoorMeshes(model, matcher) {
  const result = [];

  model.traverse((object) => {
    if (object.isMesh && matcher(object.name || "")) {
      result.push(object);
    }
  });

  return result;
}

function getWorldBox(objects) {
  const box = new THREE.Box3();

  objects.forEach((object) => {
    box.expandByObject(object);
  });

  return box;
}

function buildDoorPivot(model, objects, pivot, side) {
  if (objects.length === 0) {
    return false;
  }

  model.updateWorldMatrix(true, true);

  const box = getWorldBox(objects);
  const center = box.getCenter(new THREE.Vector3());
  const hingeWorld = center.clone();

  if (side === "left") {
    hingeWorld.z = box.min.z;
  } else {
    hingeWorld.z = box.max.z;
  }

  const hingeLocal = model.worldToLocal(hingeWorld.clone());

  pivot.position.copy(hingeLocal);
  pivot.rotation.set(0, 0, 0);

  model.add(pivot);

  objects.forEach((object) => {
    pivot.attach(object);
  });

  pivot.visible = true;
  return true;
}

// ======================================================
// 20. اختيار أجزاء الإطارات
// ======================================================

function collectWheelParts(model) {
  const result = [];

  model.traverse((object) => {
    if (!object.isMesh) {
      return;
    }

    const name = (object.name || "").toLowerCase();

    const isTire =
      (name.includes("wheel") || name.includes("tirebmw")) &&
      !name.includes("brake") &&
      !name.includes("hub") &&
      !name.includes("disk") &&
      !name.includes("disc");

    if (isTire) {
      result.push(object);
    }
  });

  return result;
}

// ======================================================
// 21. تجهيز الموديل
// ======================================================

function prepareModel(model) {
  model.traverse((object) => {
    if (!object.isMesh) {
      return;
    }

    object.castShadow = true;
    object.receiveShadow = true;

    if (object.material) {
      const materials = Array.isArray(object.material)
        ? object.material
        : [object.material];

      materials.forEach((material) => {
        material.envMapIntensity = 1.4;
      });
    }
  });

  const originalBox = new THREE.Box3().setFromObject(model);
  const originalSize = originalBox.getSize(new THREE.Vector3());
  const originalWidth = Math.max(originalSize.x, originalSize.z);

  if (!originalWidth || originalWidth <= 0) {
    throw new Error("تعذر حساب حجم موديل BMW");
  }

  const targetWidth = 7.2;
  model.scale.setScalar(targetWidth / originalWidth);

  const scaledBox = new THREE.Box3().setFromObject(model);
  const center = scaledBox.getCenter(new THREE.Vector3());

  model.position.x -= center.x;
  model.position.z -= center.z;

  const finalBox = new THREE.Box3().setFromObject(model);

  model.position.y -= finalBox.min.y;
  model.position.y += 0.04;

  return model;
}

// ======================================================
// 22. تحميل BMW
// ======================================================

const loader = new GLTFLoader();
const modelPath = "./assets/models/bmw_m4_gt3_evo_2025.glb";

loader.load(
  modelPath,
  (gltf) => {
    try {
      const model = prepareModel(gltf.scene);
      realCarGroup.add(model);

      const leftDoorMeshes = getDoorMeshes(model, isLeftDoorName);
      const rightDoorMeshes = getDoorMeshes(model, isRightDoorName);

      buildDoorPivot(model, leftDoorMeshes, leftDoorPivot, "left");
      buildDoorPivot(model, rightDoorMeshes, rightDoorPivot, "right");

      collectWheelParts(model).forEach((wheel) => {
        wheelParts.push(wheel);
      });

      realCarGroup.visible = true;
      carGroup.position.copy(startPosition);
      carGroup.scale.setScalar(startScale);

      modelReady = true;
      hud.style.opacity = "1";
      animationStartTime = performance.now();
      lastTime = animationStartTime;

      console.log("BMW M4 GT3 EVO 2025 loaded successfully");
      console.log("Left door pieces:", leftDoorMeshes.length);
      console.log("Right door pieces:", rightDoorMeshes.length);
      console.log("Wheel parts ready:", wheelParts.length);

      if (loadingMessage) {
        loadingMessage.remove();
      }
    } catch (error) {
      console.error("BMW preparation failed:", error);

      if (loadingMessage) {
        loadingMessage.textContent = "BMW preparation failed";
      }
    }
  },
  (progressEvent) => {
    if (progressEvent.total && loadingMessage) {
      const percent = (progressEvent.loaded / progressEvent.total) * 100;
      loadingMessage.textContent = `Loading BMW ${percent.toFixed(0)}%`;
    }
  },
  (error) => {
    console.error("BMW loading failed:", error);

    if (loadingMessage) {
      loadingMessage.textContent = "BMW model could not be loaded";
      loadingMessage.style.color = "#ff9d9d";
    }
  }
);

// ======================================================
// 23. الصوت
// ======================================================

const soundButton = document.createElement("button");
soundButton.className = "bmw-btn";
soundButton.style.top = "92px";
soundButton.textContent = "Start engine";
document.body.appendChild(soundButton);

const engineStartSound = new Audio("./assets/audio/engine-start.mp3");
const engineIdleSound = new Audio("./assets/audio/engine-idle.mp3");
const engineRevSound = new Audio("./assets/audio/engine-rev.mp3");

engineIdleSound.loop = true;
engineRevSound.loop = true;

engineStartSound.preload = "auto";
engineIdleSound.preload = "auto";
engineRevSound.preload = "auto";

engineStartSound.volume = 0.8;
engineIdleSound.volume = 0;
engineRevSound.volume = 0;

let soundEnabled = false;
let idleStarted = false;
let revStarted = false;
let idleTimeout = null;
let revTimeout = null;

function playAudio(audio) {
  const promise = audio.play();

  if (promise) {
    promise.catch(() => {
      console.warn("المتصفح منع تشغيل الصوت أو الملف غير موجود.");
    });
  }
}

function stopAllSounds() {
  clearTimeout(idleTimeout);
  clearTimeout(revTimeout);

  [engineStartSound, engineIdleSound, engineRevSound].forEach((audio) => {
    audio.pause();
    audio.currentTime = 0;
  });

  engineIdleSound.volume = 0;
  engineRevSound.volume = 0;
  idleStarted = false;
  revStarted = false;
}

function startEngineSequence() {
  playAudio(engineStartSound);

  idleTimeout = setTimeout(() => {
    if (!soundEnabled || idleStarted) {
      return;
    }

    engineIdleSound.volume = 0.16;
    playAudio(engineIdleSound);
    idleStarted = true;
  }, 650);

  revTimeout = setTimeout(() => {
    if (!soundEnabled || revStarted) {
      return;
    }

    engineRevSound.volume = 0.04;
    playAudio(engineRevSound);
    revStarted = true;
  }, 850);
}

function toggleSound() {
  soundEnabled = !soundEnabled;

  if (soundEnabled) {
    soundButton.textContent = "Sound on";
    startEngineSequence();
  } else {
    soundButton.textContent = "Start engine";
    stopAllSounds();
  }
}

soundButton.addEventListener("click", toggleSound);

function updateEngineSound(speed) {
  if (!soundEnabled) {
    return;
  }

  const idleTarget = entranceFinished ? 0.16 : 0.11;
  const revTarget =
    (entranceFinished ? 0.015 : 0.04 + speed * 0.22) + revBoost * 0.35;

  engineIdleSound.volume = THREE.MathUtils.clamp(
    THREE.MathUtils.lerp(engineIdleSound.volume, idleTarget, 0.06),
    0,
    1
  );

  engineRevSound.volume = THREE.MathUtils.clamp(
    THREE.MathUtils.lerp(engineRevSound.volume, revTarget, 0.06),
    0,
    1
  );

  engineRevSound.playbackRate = THREE.MathUtils.lerp(
    engineRevSound.playbackRate,
    0.92 + speed * 0.22 + revBoost * 0.5,
    0.06
  );
}

// ======================================================
// 24. فتح الأبواب
// ======================================================

function updateDoors(progress) {
  const amount = THREE.MathUtils.clamp(progress, 0, 1);
  const smoothAmount = 1 - Math.pow(1 - amount, 3);

  leftDoorPivot.rotation.y = THREE.MathUtils.degToRad(-48) * smoothAmount;
  rightDoorPivot.rotation.y = THREE.MathUtils.degToRad(48) * smoothAmount;
}

// ======================================================
// 25. دوران العجلات
// ======================================================

function updateWheels(speed, delta) {
  const rotationAmount = speed * 7 * delta;

  wheelParts.forEach((wheel) => {
    wheel.rotation.x += rotationAmount;
  });
}

// ======================================================
// 26. إضاءة الكشافات (fade-in with warm-up flicker)
// ======================================================

function updateHeadlights(progress) {
  const raw = THREE.MathUtils.clamp(progress / 0.22, 0, 1);
  const brightness =
    raw >= 1 ? 1 : raw * (0.78 + Math.random() * 0.22);

  const intensity = brightness * 2.7;

  headlightLeft.intensity = intensity;
  headlightRight.intensity = intensity;
}

// ======================================================
// 26.1 Brake lights (late entrance + stop flash)
// ======================================================

function updateBrakeLights(progress, currentTime) {
  let amount = 0;

  if (progress > 0.82 && progress < 1) {
    amount = THREE.MathUtils.smoothstep(progress, 0.82, 0.95);
  } else if (progress >= 1 && settleTime > 0) {
    amount = Math.exp(-(currentTime - settleTime) / 400);
  }

  brakeMaterial.opacity = amount * 0.9;
  brakeGlow.intensity = amount * 9;
}

// ======================================================
// 26.2 Suspension: settle bounce + orbit roll + idle sway
// ======================================================

function updateSuspension(currentTime, elapsed) {
  const azimuth = Math.atan2(
    camera.position.x - controls.target.x,
    camera.position.z - controls.target.z
  );

  let delta = azimuth - lastAzimuth;

  if (delta > Math.PI) {
    delta -= Math.PI * 2;
  }

  if (delta < -Math.PI) {
    delta += Math.PI * 2;
  }

  lastAzimuth = azimuth;

  const rollTarget = THREE.MathUtils.clamp(
    -delta * 0.2,
    -0.018,
    0.018
  );

  suspensionRoll = THREE.MathUtils.lerp(
    suspensionRoll,
    rollTarget,
    0.06
  );

  const settleAge = currentTime - settleTime;
  const settlePitch =
    Math.sin(settleAge * 0.014) * 0.014 * Math.exp(-settleAge / 500);

  const idle = reduceMotion ? 0 : Math.sin(elapsed * 0.0011) * 0.0012;

  carGroup.rotation.z = suspensionRoll + idle;
  carGroup.rotation.x = settlePitch + idle * 0.5;
}

// ======================================================
// 27. نار الشكمان
// ======================================================

function getExhaustIntensity(progress) {
  const arrival = progress > 0.82 && progress < 1 ? 1 : 0;
  return Math.max(arrival, revBoost);
}

function updateExhaustParticles(progress, elapsed) {
  const isActive =
    (progress > 0.78 && progress < 1) || revBoost > 0.02;

  exhaustParticles.visible = isActive;

  if (!isActive) {
    return;
  }

  const reach = 0.75 * (1 + revBoost * 1.2);

  exhaustParticleData.forEach((data) => {
    const particle = data.particle;
    const cycle = ((elapsed * data.speed) / 10 + data.offset) % 1;

    particle.position.x = 3.35 + cycle * reach;
    particle.position.y =
      0.18 +
      Math.sin(elapsed * 0.012 + data.offset) * 0.06 +
      cycle * 0.16;
    particle.position.z =
      data.baseZ + Math.sin(elapsed * 0.01 + data.offset) * 0.05;

    const fade = 1 - cycle;
    particle.material.opacity = fade * 0.85;
    particle.material.color.setHSL(0.09 - cycle * 0.07, 1, 0.5);
    particle.scale.setScalar((0.45 + cycle * 1.2) * fade);
  });
}

function updateExhaustFire(progress, elapsed) {
  const intensity = getExhaustIntensity(progress);
  const active = intensity > 0.02;

  exhaustFireGroup.visible = active;
  updateExhaustParticles(progress, elapsed);

  exhaustLight.intensity = active
    ? intensity * (3 + Math.random() * 1.5)
    : 0;

  if (!active) {
    return;
  }

  const pulse =
    (0.75 + Math.sin(elapsed * 0.035) * 0.25) * (0.6 + intensity * 0.6);

  const flickerLeft = pulse * (0.9 + Math.random() * 0.2);
  const flickerRight = pulse * (0.9 + Math.random() * 0.2);

  flameLeft.scale.set(flickerLeft, flickerLeft, flickerLeft);
  flameRight.scale.set(flickerRight, flickerRight, flickerRight);
}

// ======================================================
// 27.1 عداد السرعة والـ RPM
// ======================================================

let lastHudText = "";

function updateHud(speed) {
  const kmh = Math.round((speed * 180) / 5) * 5;
  const rpm = Math.min(
    9000,
    Math.round((900 + speed * 5200 + revBoost * 5500) / 50) * 50
  );

  const text = kmh + "|" + rpm;

  if (text === lastHudText) {
    return;
  }

  lastHudText = text;
  hudSpeed.textContent = kmh;
  hudRpm.textContent = rpm;
}

// ======================================================
// 28. دوال الحركة
// ======================================================

function easeInOutCubic(value) {
  return value < 0.5
    ? 4 * value * value * value
    : 1 - Math.pow(-2 * value + 2, 3) / 2;
}

function easeOutCubic(value) {
  return 1 - Math.pow(1 - value, 3);
}

// ======================================================
// 29. زر Replay
// ======================================================

const replayButton = document.createElement("button");
replayButton.className = "bmw-btn";
replayButton.style.top = "142px";
replayButton.textContent = "Replay";
document.body.appendChild(replayButton);

function replayScene() {
  if (!modelReady) {
    return;
  }

  animationStartTime = performance.now();
  lastTime = animationStartTime;
  entranceFinished = false;
  doorsStarted = false;
  doorsFinished = false;

  controls.enabled = false;
  controls.autoRotate = false;
  clearTimeout(autoRotateTimer);
  controlHint.style.opacity = "0";

  camera.position.copy(cameraStart);
  controls.target.copy(lookTarget);
  camera.lookAt(lookTarget);

  carGroup.position.copy(startPosition);
  carGroup.scale.setScalar(startScale);
  carGroup.rotation.set(0, 0, 0);

  realCarGroup.rotation.y = MODEL_YAW;
  scrollCarTilt = 0;
  revBoost = 0;
  settleTime = 0;
  suspensionRoll = 0;

  leftDoorPivot.rotation.y = 0;
  rightDoorPivot.rotation.y = 0;

  exhaustFireGroup.visible = false;
  exhaustParticles.visible = false;
  exhaustLight.intensity = 0;

  camera.fov = 38;
  camera.updateProjectionMatrix();

  if (soundEnabled) {
    stopAllSounds();
    startEngineSequence();
  }
}

replayButton.addEventListener("click", replayScene);

// ======================================================
// 29.05 زر Rev
// ======================================================

const revButton = document.createElement("button");
revButton.className = "bmw-btn";
revButton.style.top = "192px";
revButton.textContent = "Rev engine";
document.body.appendChild(revButton);

function revEngine() {
  if (!entranceFinished) {
    return;
  }

  revBoost = 1;
}

revButton.addEventListener("click", revEngine);

// ======================================================
// 29.1 اختصارات الكيبورد
// ======================================================

window.addEventListener("keydown", (event) => {
  if (event.repeat || event.ctrlKey || event.metaKey || event.altKey) {
    return;
  }

  const key = event.key.toLowerCase();

  if (key === "r") {
    replayScene();
  } else if (key === "m") {
    toggleSound();
  } else if (key === "e") {
    revEngine();
  }
});

// ======================================================
// 30. Animation Loop
// ======================================================

function animate(currentTime) {
  requestAnimationFrame(animate);

  if (!modelReady || animationStartTime === 0) {
    renderer.render(scene, camera);
    return;
  }

  const delta = Math.min((currentTime - lastTime) / 1000, 0.05);
  lastTime = currentTime;
  const elapsed = currentTime - animationStartTime;

  let progress = elapsed / entranceDuration;
  progress = THREE.MathUtils.clamp(progress, 0, 1);

  const movementProgress = easeInOutCubic(progress);
  const scaleProgress = easeOutCubic(progress);

  carGroup.position.x = THREE.MathUtils.lerp(
    startPosition.x,
    endPosition.x,
    movementProgress
  );

  carGroup.position.z = -1.4;
  carGroup.scale.setScalar(
    THREE.MathUtils.lerp(startScale, endScale, scaleProgress)
  );

  const speed = 1 - progress;

  carGroup.position.y =
    Math.sin(elapsed * 0.018) * (progress < 1 ? 0.003 : 0.0015);

  carGroup.rotation.z = THREE.MathUtils.lerp(
    carGroup.rotation.z,
    speed * 0.012,
    0.08
  );

  if (!entranceFinished) {
    camera.position.lerpVectors(cameraStart, cameraEnd, movementProgress);
    camera.lookAt(lookTarget);
    camera.fov = reduceMotion ? 38 : 38 + speed * 5;
    camera.updateProjectionMatrix();
  }

  updateWheels(speed, delta);
  updateHeadlights(progress);
  updateBrakeLights(progress, currentTime);

  revBoost = Math.max(0, revBoost - delta * 0.9);

  if (revBoost > 0.02) {
    carGroup.position.x += (Math.random() - 0.5) * 0.008 * revBoost;
    carGroup.position.y += (Math.random() - 0.5) * 0.01 * revBoost;
  }

  updateExhaustFire(progress, elapsed);
  updateEngineSound(speed);
  updateHud(speed);

  underGlow.intensity =
    4.5 + Math.sin(elapsed * 0.004) * 0.8 + revBoost * 3;

  underLightRing.material.opacity =
    0.09 + Math.sin(elapsed * 0.004) * 0.015;

  if (!reduceMotion) {
    dust.rotation.y += delta * 0.01;
  }

  if (entranceFinished) {
    scrollCarTilt = THREE.MathUtils.lerp(
      scrollCarTilt,
      pageScrollProgress,
      0.05
    );

    realCarGroup.rotation.y = MODEL_YAW + scrollCarTilt * 0.35;
  }

  if (progress >= 1 && !entranceFinished) {
    entranceFinished = true;
    stopTime = currentTime;
    settleTime = currentTime;

    lastAzimuth = Math.atan2(
      camera.position.x - controls.target.x,
      camera.position.z - controls.target.z
    );

    carGroup.position.copy(endPosition);
    carGroup.position.y = 0;
    carGroup.scale.setScalar(endScale);
    carGroup.rotation.set(0, 0, 0);

    camera.position.copy(cameraEnd);
    camera.fov = 38;
    camera.updateProjectionMatrix();
    controls.target.copy(lookTarget);
    controls.enabled = true;

    controlHint.style.opacity = "1";
    scheduleAutoRotate(3500);
  }

  if (entranceFinished && !doorsStarted && currentTime - stopTime >= 700) {
    doorsStarted = true;
  }

  if (doorsStarted && !doorsFinished) {
    const doorElapsed = currentTime - stopTime - 700;
    const doorProgress = doorElapsed / 1600;

    updateDoors(doorProgress);

    if (doorProgress >= 1) {
      doorsFinished = true;
    }
  }

  if (entranceFinished) {
    updateSuspension(currentTime, elapsed);
    controls.update();
  }

  renderer.render(scene, camera);
}

animate(performance.now());

// ======================================================
// 31. Responsive
// ======================================================

window.addEventListener("resize", () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();

  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, maxPixelRatio));
});

// ======================================================
// 32. إيقاف الصوت عند إخفاء التبويب
// ======================================================

document.addEventListener("visibilitychange", () => {
  if (document.hidden) {
    engineStartSound.pause();
    engineIdleSound.pause();
    engineRevSound.pause();
    return;
  }

  if (soundEnabled) {
    if (idleStarted) {
      playAudio(engineIdleSound);
    }

    if (revStarted) {
      playAudio(engineRevSound);
    }
  }
});
